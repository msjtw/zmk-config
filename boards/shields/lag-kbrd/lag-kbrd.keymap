#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
&kp GRAVE       &kp N1 &kp N2    &kp N3 &kp N4     &kp N5                                             &kp N6         &kp N7         &kp N8    &kp N9   &kp N0   &kp BSPC 
&kp TAB         &kp Q  &kp W     &kp E  &kp R      &kp T                                              &kp Y          &kp U          &kp I     &kp O    &kp P    &kp BSLH
&mt LCTRL ESC   &kp A  &kp S     &kp D  &kp F      &kp G                                              &kp H          &kp J          &kp K     &kp L    &kp SEMI &mt RCTRL SQT
&sk LSHFT       &kp Z  &kp X     &kp C  &kp V      &kp B          &kp C_MUTE               &kp C_PP   &kp N          &kp M          &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                        &kp SPACE  &mt LGUI MINUS &kp LBKT    &none  &none &kp RBKT   &mt RALT EQUAL &kp BSPC
                                                                  &lt 1 LBKT               &lt 2 RET
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            display-name = "lower";
            bindings = <
&trans &kp F1    &kp F2    &kp F3   &kp F4    &kp F5                                   &kp F6             &kp F7    &kp F8          &kp F9    &kp F10   &kp F11
&trans &kp N1    &kp N2    &kp N3   &kp N4    &kp N5                                   &kp N6             &kp N7    &kp N8          &kp N9    &kp N0    &kp F12
&trans &kp EXCL  &kp AT    &kp HASH &kp DLLR  &kp PRCNT                                &kp CARET          &kp AMPS  &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &trans
&trans &kp MINUS &kp UNDER &kp LBKT &kp LBRC  &kp BSLH   &trans                &trans  &kp PIPE           &kp RBRC  &kp RBKT        &kp EQUAL &kp PLUS  &trans
                                    &trans    &trans     &trans  &none  &none  &trans  &ext_power EP_TOG  &trans
                                                         &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        upper_layer {
            display-name = "upper";
            bindings = <
&trans &kp F1          &kp F2          &kp F3          &kp F4          &kp F5                                        &kp F6             &kp F7     &kp F8   &kp F9     &kp F10   &kp F11
&trans &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                                  &kp INS            &kp END    &kp HOME &kp F12    &none     &kp PG_UP
&trans &none           &none           &none           &none           &none                                         &kp LEFT           &kp DOWN   &kp UP   &kp RIGHT  &kp DEL   &kp PG_DN
&trans &bt BT_CLR      &none           &none           &none           &none           &trans                &trans  &kp SLCK           &kp C_PREV &kp C_PP &kp C_NEXT &kp PSCRN &trans
                                                       &trans          &trans          &trans  &none  &none  &trans  &ext_power EP_TOG  &trans
                                                                                       &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };
    };
};
